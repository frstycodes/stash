{
  "manifest_version": 3,
  "name": "Stash Downloads",
  "short_name": "Stash",
  "version": "0.3.0",
  "description": "Send your downloads to Stash: faster multi-connection downloads, pause and resume, and torrents.",
  "browser_specific_settings": {
    "gecko": {
      "id": "stash-downloads@frstycodes.github.io",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["downloads", "nativeMessaging", "cookies", "contextMenus", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "action": {
    "default_title": "Stash",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
